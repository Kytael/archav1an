# Python
__pycache__/
*.py[cod]
*$py.class

# Temporary/Output Folders
Input/
input/
Inputbak/
Output/
Output/sigma_label_ladder/
Temp/
build_tmp/
cropdetect-temp/
logs/
.temp/
*.log

# Runtime markers
tools/sh-used-*.txt
tools/workercount-config.txt
tools/workercount-ssimu2.txt
tools/tag-manifest*.txt

# Index files
*.bsindex
*.ffindex

# Claude Code (agent-local runtime state)
.claude/

# Heavy ML artifacts. Ignore all of models/ EXCEPT the canonical ep16_512_r4
# STA-SUNet onnx (canonical source; engines are GPU/TRT-version-specific,
# rebuilt per machine by tools/svtav1-dispatch and friends).
models/*
!models/stasunet_denoise_ep16_512_r4.onnx
!models/stasunet_denoise_ep16_512_r4.onnx.data
!models/bsvd_ft_ep5_stateful_v2_dyn_fp16.onnx
!models/bsvd_realpair_ep14_stateful_v2_dyn_fp16.onnx
!models/bsvd_sigma_estimator_v3.pth
!models/bsvd_optsig_pref_v1.json
nominations_preview/

# Implementation plans — local scratchpad, not versioned
plans/

# Per-host design docs that turned out to be moot (e.g. R76 superseded the
# vapoursynth-isolation design that was the original target of the plan).
docs/vapoursynth-isolation.md

# Test/probe source media (large videos + host-specific dumps)
prefilter/*.MOV
prefilter/*.mov
prefilter/*.MP4
prefilter/*.mp4
prefilter/VP_VULKANINFO_*.json

# Per-session reports and monitoring artifacts
REPORT_*.md
RESTART_MONITORING.md

# Editor
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
*:Zone.Identifier

# optsig_pref derived features (regenerated by make_features_csv.py)
tools/optsig_pref/features.csv
.archive-run/
Temp/_stage/
.archive-bench/
# One directory per benchmark roster (.archive-bench-r1, -r2, ...): each holds
# a manifest, a roster and a state file for one run, not shared configuration.
.archive-bench-*/
# Same for a scoped test run. Its manifest holds the archive's real filenames
# and folder names, which are personal, and the repo is public.
.archive-test-*/

# Source footage. Never commit the archive itself: a `git add -A` swept two
# clips (1.3 GB) into a commit on 2026-08-14. It was caught before the push,
# but the repo is public, so the guard belongs here rather than in a habit.
SetB/
setb/
*.MOV
*.mov
*.MP4
*.mp4
*.avi
*.AVI
*.mkv
*.MKV
